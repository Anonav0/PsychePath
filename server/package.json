{
  "name": "psychepath-server",
  "version": "1.0.0",
  "private": true,
  "description": "PsychePath REST API Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "test:all": "npm test && npm run test:models && npm run test:auth && npm run test:assessment && npm run test:profile && npm run test:curriculum && npm run test:recommendations && npm run test:gemini && npm run test:learning-path && npm run test:progress && npm run test:admin",
    "test:models": "node utils/verifyModels.js",
    "test:auth": "node utils/verifyAuth.js",
    "test:assessment": "node utils/verifyAssessments.js",
    "test:profile": "node utils/verifyProfile.js",
    "test:curriculum": "node utils/verifyCurriculum.js",
    "test:recommendations": "node utils/verifyRecommendations.js",
    "test:gemini": "node utils/verifyGemini.js",
    "test:learning-path": "node utils/verifyLearningPath.js",
    "test:progress": "node utils/verifyProgress.js",
    "test:admin": "node utils/verifyAdmin.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}
